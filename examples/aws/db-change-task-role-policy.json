{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsTheMigrationUserOnly",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:<REGION>:<PROD_ACCOUNT_ID>:dbuser:<CLAIMS_CLUSTER_RESOURCE_ID>/db_change_claims"
    },
    {
      "Sid": "ReadTheBundleWriteTheResult",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::example-db-change-runs/claims-db/*"
    }
  ]
}
