{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubEvidenceEnvironmentOfTheMonorepoOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<LOG_ARCHIVE_ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:example-org@<ORG_ID>/monorepo@<REPO_ID>:environment:evidence"
        }
      }
    }
  ]
}
