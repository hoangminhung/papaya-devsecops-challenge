{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheDbChangeTaskOnTheProdCluster",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:<REGION>:<PROD_ACCOUNT_ID>:task-definition/db-change-claims:*",
      "Condition": {
        "ArnEquals": {"ecs:cluster": "arn:aws:ecs:<REGION>:<PROD_ACCOUNT_ID>:cluster/db-change"}
      }
    },
    {
      "Sid": "PassOnlyTheDbChangeTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<PROD_ACCOUNT_ID>:role/db-change-claims-task",
        "arn:aws:iam::<PROD_ACCOUNT_ID>:role/db-change-claims-execution"
      ],
      "Condition": {
        "StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}
      }
    },
    {
      "Sid": "WaitForTheTask",
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": "arn:aws:ecs:<REGION>:<PROD_ACCOUNT_ID>:task/db-change/*"
    },
    {
      "Sid": "HandOverTheClassifiedBundleAndReadTheResult",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::example-db-change-runs/claims-db/*"
    },
    {
      "Sid": "NoShellIntoTheTask",
      "Effect": "Deny",
      "Action": "ecs:ExecuteCommand",
      "Resource": "*"
    }
  ]
}
