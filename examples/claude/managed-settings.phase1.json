{
  "requiredMinimumVersion": "2.1.248",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)"
    ],
    "deny": [
      "Read(~/.aws/**)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "example-org/claude-plugins"
    }
  ],
  "blockedMarketplaces": [],
  "disableSideloadFlags": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    {
      "serverUrl": "https://mcp.example-tracker.com/*"
    },
    {
      "serverCommand": [
        "npx",
        "-y",
        "@example-org/mcp-runbooks@1.4.2"
      ]
    }
  ],
  "disableClaudeAiConnectors": true,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel-collector.example.internal:4318",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_LOG_ASSISTANT_RESPONSES": "0",
    "OTEL_LOG_TOOL_DETAILS": "0",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_LOG_RAW_API_BODIES": "0"
  }
}
